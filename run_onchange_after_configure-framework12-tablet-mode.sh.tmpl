{{- $tablet_mode_enabled := false -}}
{{- if hasKey . "tablet_mode_enabled" -}}
{{- $tablet_mode_enabled = index . "tablet_mode_enabled" -}}
{{- else if .is_laptop -}}
{{- $tablet_mode_enabled = true -}}
{{- end -}}
{{ if and (eq .chezmoi.os "linux") .is_laptop $tablet_mode_enabled -}}
#!/usr/bin/env bash
set -euo pipefail

if [ "${CHEZMOI_SKIP_SYSTEM_POWER:-0}" = "1" ]; then
  exit 0
fi

target="/etc/mkinitcpio.conf.d/99-framework-12-tablet-mode.conf"
tmp="$(mktemp)"
trap 'rm -f "$tmp"' EXIT

cat > "$tmp" <<'MKINITCPIO'
# Force Framework Laptop 12 tablet-mode GPIO modules to load in order.
MODULES+=(pinctrl_tigerlake soc_button_array)
MKINITCPIO

if [ -r "$target" ] && cmp -s "$tmp" "$target"; then
  exit 0
fi

sudo install -d -m 755 /etc/mkinitcpio.conf.d
sudo install -m 644 "$tmp" "$target"
sudo mkinitcpio -P
{{ end -}}
