{{ if and (eq .chezmoi.os "linux") .is_laptop -}}
#!/usr/bin/env bash
set -euo pipefail

if [ "${CHEZMOI_SKIP_SYSTEM_POWER:-0}" = "1" ]; then
  exit 0
fi

tmpdir="$(mktemp -d)"
trap 'rm -rf "$tmpdir"' EXIT

mkdir -p "$tmpdir/framework12-battery"

cat > "$tmpdir/framework12-battery/tuned.conf" <<'TUNED'
[main]
summary=Framework Laptop 12 battery profile
include=powersave

[script]
script=${i:PROFILE_DIR}/apply.sh
TUNED

cat > "$tmpdir/framework12-battery/apply.sh" <<'SCRIPT'
#!/usr/bin/env bash
set -euo pipefail

case "${1:-start}" in
  start|verify|restart)
    ;;
  stop)
    exit 0
    ;;
  *)
    exit 0
    ;;
esac

# Use the efficient named EPP this kernel exposes, while keeping turbo available.
# This is less sluggish than forcing the raw "power" preference for all work.
for epp in /sys/devices/system/cpu/cpu*/cpufreq/energy_performance_preference; do
  [ -w "$epp" ] || continue
  printf '%s\n' balance_power > "$epp" 2>/dev/null || printf '%s\n' power > "$epp" 2>/dev/null || true
done

for bias in /sys/devices/system/cpu/cpu*/power/energy_perf_bias; do
  [ -w "$bias" ] || continue
  printf '%s\n' 10 > "$bias" 2>/dev/null || true
done

# Keep turbo available for short bursts; EPP still biases idle/light work down.
if [ -w /sys/devices/system/cpu/intel_pstate/no_turbo ]; then
  printf '0\n' > /sys/devices/system/cpu/intel_pstate/no_turbo 2>/dev/null || true
fi

for control in /sys/bus/pci/devices/*/power/control /sys/bus/usb/devices/*/power/control; do
  [ -w "$control" ] || continue
  printf 'auto\n' > "$control" 2>/dev/null || true
done

if command -v iw >/dev/null 2>&1; then
  for iface in /sys/class/net/*/wireless; do
    [ -d "$iface" ] || continue
    iface="$(basename "$(dirname "$iface")")"
    iw dev "$iface" set power_save on 2>/dev/null || true
  done
fi
SCRIPT

chmod 755 "$tmpdir/framework12-battery/apply.sh"

sudo rm -rf /etc/tuned/framework12-battery
sudo install -d /etc/tuned/profiles/framework12-battery
sudo install -m 644 "$tmpdir/framework12-battery/tuned.conf" /etc/tuned/profiles/framework12-battery/tuned.conf
sudo install -m 755 "$tmpdir/framework12-battery/apply.sh" /etc/tuned/profiles/framework12-battery/apply.sh

sudo systemctl disable --now power-profiles-daemon.service 2>/dev/null || true
if systemctl list-unit-files tuned.service --no-legend 2>/dev/null | grep -q '^tuned\.service'; then
  sudo systemctl enable --now tuned.service
fi
if systemctl list-unit-files tuned-ppd.service --no-legend 2>/dev/null | grep -q '^tuned-ppd\.service'; then
  sudo systemctl enable --now tuned-ppd.service
fi
{{ end -}}
