{{ if and (eq .chezmoi.os "linux") .is_laptop -}}
#!/usr/bin/env bash
set -euo pipefail

if [ "${CHEZMOI_SKIP_SYSTEM_POWER:-0}" = "1" ]; then
  exit 0
fi

tmp="$(mktemp)"
trap 'rm -f "$tmp"' EXIT

cat > "$tmp" <<'SLEEP'
[Sleep]
MemorySleepMode=s2idle
AllowSuspendThenHibernate=yes
HibernateDelaySec=45min
HibernateOnACPower=no
SuspendEstimationSec=15min
SLEEP

sudo install -Dm644 "$tmp" /etc/systemd/sleep.conf.d/10-memory-sleep.conf
{{ end -}}
