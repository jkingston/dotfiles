{{ if eq .chezmoi.os "linux" -}}
#!/usr/bin/env bash
set -euo pipefail

app_id="app.zen_browser.zen"
zen_dir="$HOME/.var/app/$app_id/.zen"

if command -v flatpak >/dev/null 2>&1 && flatpak info "$app_id" >/dev/null 2>&1; then
{{- if eq .gpu "intel" }}
  flatpak override --user \
    --env=MOZ_ENABLE_WAYLAND=1 \
    --env=LIBVA_DRIVER_NAME=iHD \
    "$app_id" >/dev/null
{{- else }}
  flatpak override --user \
    --env=MOZ_ENABLE_WAYLAND=1 \
    "$app_id" >/dev/null
{{- end }}
fi

[ -d "$zen_dir" ] || exit 0

while IFS= read -r -d '' profile; do
  [ -f "$profile/prefs.js" ] || [ -f "$profile/compatibility.ini" ] || continue
  cat > "$profile/user.js" <<'USERJS'
// Managed by chezmoi. Keep browser/video rendering efficient on Linux Wayland.
user_pref("media.ffmpeg.vaapi.enabled", true);
user_pref("media.hardware-video-decoding.force-enabled", true);
user_pref("media.rdd-vpx.enabled", true);
user_pref("gfx.webrender.all", true);
user_pref("widget.dmabuf.force-enabled", true);
user_pref("widget.wayland-dmabuf-vaapi.enabled", true);
USERJS
done < <(find "$zen_dir" -mindepth 1 -maxdepth 1 -type d -print0)
{{ end -}}
