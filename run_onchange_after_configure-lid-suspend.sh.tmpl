{{ if and (eq .chezmoi.os "linux") .is_laptop -}}
#!/usr/bin/env bash
set -euo pipefail

if [ "${CHEZMOI_SKIP_SYSTEM_POWER:-0}" = "1" ]; then
  exit 0
fi

tmp="$(mktemp)"
trap 'rm -f "$tmp"' EXIT

cat > "$tmp" <<'LID'
[Login]
HandleLidSwitch=suspend-then-hibernate
HandleLidSwitchExternalPower=suspend
HandleLidSwitchDocked=ignore
HoldoffTimeoutSec=2s
InhibitDelayMaxSec=2s
LID

sudo install -Dm644 "$tmp" /etc/systemd/logind.conf.d/lid.conf
sudo systemctl try-reload-or-restart systemd-logind.service
{{ end -}}
