#!/usr/bin/env bash
set -euo pipefail

if /usr/bin/pinentry-qt --version >/dev/null 2>&1; then
  export QT_QPA_PLATFORM="${QT_QPA_PLATFORM:-wayland;xcb}"
  export QT_SCALE_FACTOR="${PINENTRY_QT_SCALE_FACTOR:-{{ .monitor_scale }}}"
  exec /usr/bin/pinentry-qt "$@"
fi

export GDK_BACKEND="${GDK_BACKEND:-wayland,x11}"
export GDK_SCALE="${PINENTRY_GDK_SCALE:-{{ if ge .monitor_scale "1.5" }}2{{ else }}1{{ end }}}"
exec /usr/bin/pinentry-gtk "$@"
