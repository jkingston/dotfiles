#!/usr/bin/env bash
set -euo pipefail

CONFIG_ITEM="${SSH_HOSTS_CONFIG_ITEM:-ssh/hosts}"
CONFIG_FIELD="${SSH_HOSTS_CONFIG_FIELD:-config}"
LOCAL_CONFIG="${SSH_HOSTS_LOCAL_CONFIG:-$HOME/.ssh/config.local}"
KEY_DIR="${SSH_HOSTS_KEY_DIR:-$HOME/.ssh/rbw}"
RBW_AGENT_SOCKET="${SSH_AUTH_SOCK:-${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/rbw/ssh-agent-socket}"

require() {
  command -v "$1" >/dev/null 2>&1 || {
    printf 'Missing %s\n' "$1" >&2
    exit 1
  }
}

say() {
  if command -v gum >/dev/null 2>&1; then
    gum style --foreground 212 "$1"
  else
    printf '%s\n' "$1"
  fi
}

template() {
  cat <<'JSON'
{
  "hosts": [
    {
      "alias": "nas",
      "hostname": "nas.local",
      "user": "jack",
      "key": "nas",
      "port": 22
    }
  ],
  "keys": [
    {
      "name": "nas",
      "item": "ssh/keys/nas",
      "field": "public key"
    }
  ]
}
JSON
}

fetch_config() {
  require rbw
  require jq
  rbw get "$CONFIG_ITEM" --field "$CONFIG_FIELD"
}

validate_config() {
  jq -e '
    type == "object" and
    (.hosts | type == "array") and
    (.keys | type == "array") and
    all(.hosts[]; (.alias and .hostname and .user and .key)) and
    all(.keys[]; (.name and .item and .field))
  ' >/dev/null
}

write_ssh_config() {
  local config="$1"
  install -d -m 700 "$HOME/.ssh" "$KEY_DIR"

  {
    printf '# Generated by ssh-hosts from rbw item %s field %s.\n' "$CONFIG_ITEM" "$CONFIG_FIELD"
    printf '# Edit the Bitwarden config, then run: ssh-hosts sync\n\n'
    jq -r '
      .hosts[] |
      "Host \(.alias)\n" +
      "  HostName \(.hostname)\n" +
      "  User \(.user)\n" +
      (if .port then "  Port \(.port)\n" else "" end) +
      (if .key then "  IdentityFile ~/.ssh/rbw/\(.key).pub\n  IdentitiesOnly yes\n" else "" end) +
      (if .extra then (.extra | to_entries | map("  \(.key) \(.value)\n") | add) else "" end)
    ' <<<"$config"
  } >"$LOCAL_CONFIG"

  chmod 600 "$LOCAL_CONFIG"
}

write_public_keys() {
  local config="$1"
  local name item field target

  while IFS=$'\t' read -r name item field; do
    [ -n "$name" ] || continue
    target="$KEY_DIR/$name.pub"
    rbw get "$item" --field "$field" >"$target"
    chmod 600 "$target"
  done < <(jq -r '.keys[] | [.name, .item, .field] | @tsv' <<<"$config")
}

sync_hosts() {
  local config
  say "Fetching SSH host config from Bitwarden"
  config="$(fetch_config)"
  validate_config <<<"$config"
  write_ssh_config "$config"
  write_public_keys "$config"
  say "Wrote $LOCAL_CONFIG and public key selectors in $KEY_DIR"
}

list_hosts() {
  local config
  config="$(fetch_config)"
  validate_config <<<"$config"
  jq -r '.hosts[] | [.alias, .user + "@" + .hostname, (.key // "-")] | @tsv' <<<"$config" |
    column -t -s $'\t'
}

show_config() {
  fetch_config | jq .
}

edit_config() {
  require rbw
  rbw edit "$CONFIG_ITEM"
}

test_host() {
  local host="${1:-}"
  if [ -z "$host" ]; then
    if command -v gum >/dev/null 2>&1; then
      host="$(list_hosts | awk '{print $1}' | gum choose --header "SSH host")"
    else
      printf 'Usage: ssh-hosts test <host>\n' >&2
      exit 2
    fi
  fi

  SSH_AUTH_SOCK="$RBW_AGENT_SOCKET" ssh -o BatchMode=yes -T "$host"
}

menu() {
  require gum
  local choice
  choice="$(gum choose \
    "Sync config and keys" \
    "List hosts" \
    "Show Bitwarden config" \
    "Edit Bitwarden item" \
    "Test host" \
    "Print template")" || exit 0

  case "$choice" in
    "Sync config and keys") sync_hosts ;;
    "List hosts") list_hosts ;;
    "Show Bitwarden config") show_config ;;
    "Edit Bitwarden item") edit_config ;;
    "Test host") test_host ;;
    "Print template") template ;;
  esac
}

usage() {
  cat <<EOF
Usage: ssh-hosts <command>

Commands:
  menu       Open the gum menu
  sync       Pull config from rbw and generate ~/.ssh/config.local
  list       List configured hosts from Bitwarden
  show       Print the Bitwarden JSON config
  edit       Open the Bitwarden config item in \$EDITOR
  test HOST  Test SSH auth for a generated host
  template   Print an example Bitwarden config JSON

Environment:
  SSH_HOSTS_CONFIG_ITEM   Bitwarden item name. Default: $CONFIG_ITEM
  SSH_HOSTS_CONFIG_FIELD  Bitwarden field name. Default: $CONFIG_FIELD
EOF
}

case "${1:-menu}" in
  menu) menu ;;
  sync) sync_hosts ;;
  list) list_hosts ;;
  show) show_config ;;
  edit) edit_config ;;
  test) shift; test_host "${1:-}" ;;
  template) template ;;
  -h|--help|help) usage ;;
  *)
    usage >&2
    exit 2
    ;;
esac
