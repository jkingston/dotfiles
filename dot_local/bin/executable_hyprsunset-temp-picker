#!/usr/bin/env bash
# Temperature picker with live preview

CONFIG_DIR="$HOME/.config/hyprsunset"
PREV_TEMP=$(cat "$CONFIG_DIR/temperature" 2>/dev/null || echo "3500")
LAST_VALUE=""
LAST_INDEX=-1

LABELS=(
  "Extreme (1000K)"
  "Candle (1500K)"
  "Ember (2000K)"
  "Warm (2500K)"
  "Cozy (3000K)"
  "Soft (3500K)"
  "Reading (4000K)"
  "Mild (4500K)"
)
VALUES=(1000 1500 2000 2500 3000 3500 4000 4500)

MENU=$(printf '%s\n' "${LABELS[@]}")

apply_temp() {
  pkill -x hyprsunset 2>/dev/null
  while pgrep -x hyprsunset >/dev/null; do sleep 0.1; done
  hyprsunset -t "$1"
}

selection_index() {
  local selected="$1"
  local index

  for index in "${!LABELS[@]}"; do
    if [ "${LABELS[$index]}" = "$selected" ]; then
      echo "$index"
      return 0
    fi
  done

  return 1
}

preview_to_selection() {
  local selected_index="$1"
  local start_index="$((LAST_INDEX + 1))"
  local index

  # The first row selections below 2500K are extreme values, so avoid stepping
  # through them while simulating keyboard navigation to a warmer/cooler preset.
  if [ "$LAST_INDEX" -lt 0 ] && [ "$selected_index" -ge 3 ]; then
    start_index=3
  fi

  if [ "$start_index" -gt "$selected_index" ]; then
    start_index="$selected_index"
  fi

  for ((index = start_index; index <= selected_index; index++)); do
    apply_temp "${VALUES[$index]}"
  done
}

# Show rofi, apply on each selection
while true; do
  SELECTED=$(echo "$MENU" | rofi -dmenu -p "Temperature (ESC to cancel)" -i)

  if [ -z "$SELECTED" ]; then
    # ESC pressed - revert to previous
    if [ -f /tmp/hyprsunset-night ]; then
      pkill -x hyprsunset 2>/dev/null
      while pgrep -x hyprsunset >/dev/null; do sleep 0.1; done
      hyprsunset -t "$PREV_TEMP"
    fi
    break
  fi

  # Extract temperature value from selection
  VALUE=$(echo "$SELECTED" | grep -oP '\d+(?=K)')

  if [ -n "$VALUE" ]; then
    INDEX=$(selection_index "$SELECTED" || echo "")

    # Apply live preview
    if [ -n "$INDEX" ]; then
      preview_to_selection "$INDEX"
      LAST_INDEX="$INDEX"
    else
      apply_temp "$VALUE"
    fi

    # Save and exit on second selection of same value (confirm)
    if [ "$VALUE" = "$LAST_VALUE" ]; then
      mkdir -p "$CONFIG_DIR"
      echo "$VALUE" > "$CONFIG_DIR/temperature"
      notify-send -t 1500 "Temperature: ${VALUE}K"
      exit 0
    fi
    LAST_VALUE="$VALUE"
  fi
done
