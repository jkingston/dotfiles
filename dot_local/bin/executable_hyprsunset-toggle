#!/usr/bin/env bash
# Cycle through: Auto -> On -> Off -> Auto

CONFIG_DIR="$HOME/.config/hyprsunset"
MODE_FILE="$CONFIG_DIR/mode"

read_mode() {
  case "$(cat "$MODE_FILE" 2>/dev/null || echo auto)" in
    auto|on|off) cat "$MODE_FILE" 2>/dev/null || echo auto ;;
    *) echo auto ;;
  esac
}

mkdir -p "$CONFIG_DIR"

case "$(read_mode)" in
  auto)
    NEXT_MODE="on"
    ;;
  on)
    NEXT_MODE="off"
    ;;
  off)
    NEXT_MODE="auto"
    ;;
esac

printf '%s\n' "$NEXT_MODE" > "$MODE_FILE"
~/.local/bin/hyprsunset-apply

TEMP=$(cat "$CONFIG_DIR/temperature" 2>/dev/null || echo "3500")
STATE=$(cat "$CONFIG_DIR/applied-state" 2>/dev/null || echo off)

case "$STATE" in
  on)
    STATE_LABEL="ON (${TEMP}K)"
    ;;
  *)
    STATE_LABEL="OFF"
    ;;
esac

if [ "$NEXT_MODE" = "auto" ]; then
  LABEL="Auto (${STATE_LABEL})"
else
  LABEL="$STATE_LABEL"
fi

notify-send -t 1500 "Night Light: ${LABEL}"
