#!/usr/bin/env bash
# Cycle through: Auto -> On -> Off -> Auto

CONFIG_DIR="$HOME/.config/hyprsunset"
MODE_FILE="$CONFIG_DIR/mode"

read_mode() {
  case "$(cat "$MODE_FILE" 2>/dev/null || echo auto)" in
    auto|on|off) cat "$MODE_FILE" 2>/dev/null || echo auto ;;
    *) echo auto ;;
  esac
}

mkdir -p "$CONFIG_DIR"

case "$(read_mode)" in
  auto)
    NEXT_MODE="on"
    ;;
  on)
    NEXT_MODE="off"
    ;;
  off)
    NEXT_MODE="auto"
    ;;
esac

printf '%s\n' "$NEXT_MODE" > "$MODE_FILE"
~/.local/bin/hyprsunset-apply

TEMP=$(cat "$CONFIG_DIR/temperature" 2>/dev/null || echo "3500")
STATE=$(cat "$CONFIG_DIR/applied-state" 2>/dev/null || echo off)

case "$NEXT_MODE:$STATE" in
  on:on)
    MESSAGE="Night Light: On (${TEMP}K)"
    ;;
  off:off)
    MESSAGE="Night Light: Off"
    ;;
  auto:on)
    MESSAGE="Night Light: Auto (On, ${TEMP}K)"
    ;;
  auto:off)
    MESSAGE="Night Light: Auto (Off)"
    ;;
  *)
    MESSAGE="Night Light: ${NEXT_MODE}"
    ;;
esac

notify-send -t 1500 "$MESSAGE"
