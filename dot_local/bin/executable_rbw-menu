#!/usr/bin/env bash
set -u

notify() {
  notify-send -t 3000 "rbw" "$1" 2>/dev/null || true
}

require_command() {
  local command="$1"
  if command -v "$command" >/dev/null 2>&1; then
    return 0
  fi
  notify "Missing $command; install rbw and rofi-rbw"
  return 1
}

choose() {
  printf '%s\n' "$@" | rofi -dmenu -i -p "Vault"
}

prompt_value() {
  local prompt="$1"
  rofi -dmenu -p "$prompt"
}

run_terminal() {
  uwsm app -- ghostty --class=com.floating.tui -e bash -lc "$1"
}

is_configured() {
  [ -s "$HOME/.config/rbw/config.json" ]
}

is_unlocked() {
  command -v rbw >/dev/null 2>&1 || return 1
  rbw unlocked >/dev/null 2>&1
}

ensure_agent() {
  systemctl --user start rbw-agent.service >/dev/null 2>&1 || true
}

config_value() {
  local key="$1"
  if ! is_configured; then
    printf 'unset'
    return 0
  fi
  require_command rbw >/dev/null || {
    printf 'unavailable'
    return 0
  }
  rbw config show 2>/dev/null | jq -r --arg key "$key" '.[$key] // "unset"' 2>/dev/null
}

email_label() {
  printf 'Set email (current: %s)' "$(config_value email)"
}

server_label() {
  local server
  server="$(config_value base_url)"
  if [ "$server" = "unset" ]; then
    server="official cloud"
  fi
  printf 'Set server (current: %s)' "$server"
}

set_email() {
  require_command rbw || return 0
  local email
  email="$(prompt_value "Bitwarden email")" || return 0
  [ -n "$email" ] || return 0

  if rbw config set email "$email" &&
    rbw config set pinentry pinentry-gnome3 &&
    rbw config set lock_timeout 3600 &&
    rbw config set sync_interval 3600; then
    systemctl --user enable --now rbw-agent.service >/dev/null 2>&1 || true
    notify "Configured rbw for $email"
  else
    notify "Failed to configure rbw"
  fi
}

set_server() {
  require_command rbw || return 0
  local url
  url="$(prompt_value "Server URL")" || return 0
  url="${url%/}"
  [ -n "$url" ] || return 0

  case "$url" in
    http://*|https://*) ;;
    *)
      notify "Server URL must start with http:// or https://"
      return 1
      ;;
  esac

  if rbw config set base_url "$url"; then
    rbw stop-agent >/dev/null 2>&1 || true
    systemctl --user restart rbw-agent.service >/dev/null 2>&1 || true
    notify "Set server to $url"
  else
    notify "Failed to set server"
  fi
}

reset_server() {
  require_command rbw || return 0
  if rbw config unset base_url &&
    rbw config unset identity_url &&
    rbw config unset ui_url &&
    rbw config unset notifications_url; then
    rbw stop-agent >/dev/null 2>&1 || true
    systemctl --user restart rbw-agent.service >/dev/null 2>&1 || true
    notify "Using official Bitwarden cloud"
  else
    notify "Failed to reset server"
  fi
}

set_numeric_config() {
  require_command rbw || return 0
  local key="$1"
  local prompt="$2"
  local value
  value="$(prompt_value "$prompt")" || return 0
  case "$value" in
    ''|*[!0-9]*)
      notify "Invalid value"
      return 1
      ;;
  esac
  if rbw config set "$key" "$value"; then
    notify "Set $key to $value"
  else
    notify "Failed to set $key"
  fi
}

run_rbw_action() {
  local label="$1"
  local command="$2"

  if bash -lc "$command"; then
    notify "$label complete"
  else
    notify "$label failed"
  fi
}

open_credentials() {
  require_command rbw || return 0
  require_command rofi-rbw || return 0
  if ! is_configured; then
    notify "Set your rbw email first"
    return 0
  fi

  export RBW_CLIPBOARD_CLEAR_AFTER=45
  PATH="$HOME/.local/lib/rbw-clipboard:$PATH" rofi-rbw \
    --selector rofi \
    --clipboarder wl-copy \
    --action copy \
    --target menu \
    --prompt "Vault" \
    --selector-args "-i" \
    --clear-after 45
}

show_status() {
  local config_state="missing"
  local lock_state="locked"
  local email="unset"

  if is_configured; then
    config_state="configured"
    email="$(rbw config show 2>/dev/null | jq -r '.email // "unset"' 2>/dev/null)"
    [ -n "$email" ] || email="unset"
  fi
  if is_unlocked; then
    lock_state="unlocked"
  fi

  notify "config: $config_state | vault: $lock_state | email: $email"
}

if is_configured; then
  ensure_agent
fi

if is_unlocked; then
  choice="$(choose \
    "Credentials" \
    "Sync vault" \
    "Lock vault" \
    "$(email_label)" \
    "$(server_label)" \
    "Use official cloud" \
    "Register device" \
    "Set lock timeout" \
    "Set sync interval" \
    "Stop agent" \
    "Status")" || exit 0
else
  choice="$(choose \
    "$(email_label)" \
    "$(server_label)" \
    "Use official cloud" \
    "Register device" \
    "Login" \
    "Unlock vault" \
    "Sync vault" \
    "Status")" || exit 0
fi

case "$choice" in
  "Credentials")
    open_credentials
    ;;
  "Set email"*)
    set_email
    ;;
  "Set server"*)
    set_server
    ;;
  "Use official cloud")
    reset_server
    ;;
  "Register device")
    run_terminal "rbw register; printf '\\nPress Enter to close...'; read -r"
    ;;
  "Login")
    run_terminal "rbw login; printf '\\nPress Enter to close...'; read -r"
    ;;
  "Unlock vault")
    run_rbw_action "Unlock" "rbw unlock"
    ;;
  "Sync vault")
    run_rbw_action "Sync" "rbw sync"
    ;;
  "Lock vault")
    run_rbw_action "Lock" "rbw lock"
    ;;
  "Set lock timeout")
    set_numeric_config lock_timeout "Lock timeout seconds"
    ;;
  "Set sync interval")
    set_numeric_config sync_interval "Sync interval seconds"
    ;;
  "Stop agent")
    run_rbw_action "Stop agent" "rbw stop-agent"
    ;;
  "Status")
    show_status
    ;;
esac
