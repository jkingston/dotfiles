#!/usr/bin/env bash
# Output JSON for waybar tooltip with sun times and current state

CONFIG_DIR="$HOME/.config/hyprsunset"
TEMP=$(cat "$CONFIG_DIR/temperature" 2>/dev/null || echo "3500")
TZ=$(timedatectl show --property=Timezone --value 2>/dev/null || echo "Europe/London")
COORDS=$(~/.local/bin/hyprsunset-coords)
read -r LAT LON _ <<< "$COORDS"
MODE=$(cat "$CONFIG_DIR/mode" 2>/dev/null || echo auto)

case "$MODE" in
  auto|on|off) ;;
  *) MODE="auto" ;;
esac

desired_state() {
  case "$MODE" in
    on)
      echo on
      ;;
    off)
      echo off
      ;;
    auto)
      if [ "$(sunwait poll "$LAT" "$LON")" = "DAY" ]; then
        echo off
      else
        echo on
      fi
      ;;
  esac
}

STATE=$(desired_state)

# The effective nightlight state is derived from mode + schedule. A running
# hyprsunset process can also mean identity/no color change, so process
# presence is not a reliable on/off signal.
if [ "$STATE" = "on" ]; then
  ICON="󱩌"
  LABEL="ON (${TEMP}K)"
else
  ICON="󰹏"
  LABEL="OFF"
fi

# Parse the actual sunrise/sunset row. Twilight rows can legitimately start
# after 02:00 in summer, but they are not the sunset time we want to display.
REPORT=$(sunwait report "$LAT" "$LON")
DAYLIGHT_LINE=$(printf '%s\n' "$REPORT" | grep -E '(^|[[:space:]])Daylight:' | grep -v 'with ' | head -n 1)
if [ -z "$DAYLIGHT_LINE" ]; then
  DAYLIGHT_LINE=$(printf '%s\n' "$REPORT" | grep "Day with twilight" | head -n 1)
fi
SUNRISE=$(printf '%s\n' "$DAYLIGHT_LINE" | grep -oE '[0-9]{1,2}:[0-9]{2}' | sed -n '1p')
SUNSET=$(printf '%s\n' "$DAYLIGHT_LINE" | grep -oE '[0-9]{1,2}:[0-9]{2}' | sed -n '2p')

# Output JSON for waybar
printf '{"text": "%s", "tooltip": "Night light: %s\\nMode: %s\\n%s\\n☀️ %s  🌙 %s"}' "$ICON" "$LABEL" "$MODE" "$TZ" "$SUNRISE" "$SUNSET"
