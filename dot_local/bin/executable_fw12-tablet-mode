#!/usr/bin/env bash
set -euo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/fw12-tablet-mode"
MODE_FILE="$STATE_DIR/mode"
ROTATION_LOCK_FILE="$STATE_DIR/rotation-locked"
ROTATION_PID_FILE="$STATE_DIR/rotation.pid"
DEFAULT_DISPLAY="${FW12_TABLET_DISPLAY:-eDP-1}"
DEFAULT_TRANSFORMS="${FW12_TABLET_TRANSFORMS:-0,1,2,3}"
DISABLE_DEVICES="${FW12_TABLET_DISABLE_DEVICES:-}"
OSK_BIN="${FW12_OSK_BIN:-wvkbd-mobintl}"
read -r -a OSK_ARGS <<<"${FW12_OSK_ARGS:--L 240 -H 360 -R 10 --alpha 250 --hidden}"
OSK_STARTUP_DELAY="${FW12_OSK_STARTUP_DELAY:-0.75}"

mkdir -p "$STATE_DIR"

notify() {
  if command -v notify-send >/dev/null 2>&1; then
    notify-send -t 1500 "$1" "${2:-}" || true
  fi
}

signal_waybar() {
  pkill -SIGRTMIN+13 waybar 2>/dev/null || true
  pkill -SIGRTMIN+14 waybar 2>/dev/null || true
}

display_name() {
  if [ -n "${FW12_TABLET_DISPLAY:-}" ]; then
    printf '%s\n' "$FW12_TABLET_DISPLAY"
    return
  fi

  if command -v hyprctl >/dev/null 2>&1 && command -v jq >/dev/null 2>&1; then
    local detected
    detected="$(hyprctl -j monitors 2>/dev/null | jq -r '[.[] | select(.name | test("^(eDP|LVDS|DSI)-"))][0].name // empty' 2>/dev/null || true)"
    if [ -n "$detected" ]; then
      printf '%s\n' "$detected"
      return
    fi
  fi

  printf '%s\n' "$DEFAULT_DISPLAY"
}

hypr_batch() {
  if command -v hyprctl >/dev/null 2>&1; then
    hyprctl --batch "$1" >/dev/null 2>&1 || true
  fi
}

apply_transform() {
  local transform="$1"
  local display
  display="$(display_name)"
  hypr_batch "keyword monitor ${display},preferred,auto,auto,transform,${transform} ; keyword input:touchdevice:transform ${transform} ; keyword input:tablet:transform ${transform}"
}

set_touch() {
  local enabled="$1"
  local display
  display="$(display_name)"
  hypr_batch "keyword input:touchdevice:enabled ${enabled} ; keyword input:touchdevice:output ${display} ; keyword input:tablet:output ${display}"
}

set_hypr_devices() {
  local enabled="$1"
  local device batch=""
  [ -n "$DISABLE_DEVICES" ] || return 0

  for device in $DISABLE_DEVICES; do
    batch="${batch}keyword device[${device}]:enabled ${enabled} ; "
  done

  hypr_batch "$batch"
}

osk_running() {
  pgrep -x "$OSK_BIN" >/dev/null 2>&1
}

osk_start() {
  command -v "$OSK_BIN" >/dev/null 2>&1 || return 0
  if ! osk_running; then
    nohup "$OSK_BIN" "${OSK_ARGS[@]}" >/dev/null 2>&1 &
    for _ in 1 2 3 4 5; do
      osk_running && break
      sleep 0.1
    done
    sleep "$OSK_STARTUP_DELAY"
  fi
}

osk_show() {
  osk_start
  pkill -SIGUSR2 -x "$OSK_BIN" 2>/dev/null || true
}

osk_hide() {
  pkill -SIGUSR1 -x "$OSK_BIN" 2>/dev/null || true
}

rotation_pid_active() {
  [ -s "$ROTATION_PID_FILE" ] || return 1
  kill -0 "$(cat "$ROTATION_PID_FILE")" 2>/dev/null
}

stop_rotation() {
  if rotation_pid_active; then
    kill "$(cat "$ROTATION_PID_FILE")" 2>/dev/null || true
  fi
  rm -f "$ROTATION_PID_FILE"
  pkill -x iio-hyprland 2>/dev/null || true
}

transform_for_orientation() {
  local orientation="$1"
  IFS=',' read -r normal left_up bottom_up right_up <<<"$DEFAULT_TRANSFORMS"
  case "$orientation" in
    normal) printf '%s\n' "${normal:-0}" ;;
    left-up) printf '%s\n' "${left_up:-1}" ;;
    bottom-up) printf '%s\n' "${bottom_up:-2}" ;;
    right-up) printf '%s\n' "${right_up:-3}" ;;
  esac
}

rotation_loop() {
  command -v monitor-sensor >/dev/null 2>&1 || exit 0
  local current="" line orientation transform
  monitor-sensor --accel 2>/dev/null | while IFS= read -r line; do
    case "$line" in
      *"orientation:"*)
        orientation="${line##*orientation: }"
        orientation="${orientation%%)*}"
        orientation="${orientation%%,*}"
        ;;
      *"Accelerometer orientation changed:"*)
        orientation="${line##*: }"
        ;;
      *)
        continue
        ;;
    esac

    case "$orientation" in
      normal|left-up|bottom-up|right-up)
        transform="$(transform_for_orientation "$orientation")"
        if [ -n "$transform" ] && [ "$transform" != "$current" ]; then
          apply_transform "$transform"
          current="$transform"
        fi
        ;;
    esac
  done
}

start_rotation() {
  [ ! -e "$ROTATION_LOCK_FILE" ] || return 0
  rotation_pid_active && return 0

  local display
  display="$(display_name)"

  if command -v iio-hyprland >/dev/null 2>&1; then
    iio-hyprland --transform "$DEFAULT_TRANSFORMS" "$display" >/dev/null 2>&1 &
    printf '%s\n' "$!" > "$ROTATION_PID_FILE"
    return 0
  fi

  if command -v monitor-sensor >/dev/null 2>&1; then
    "$0" rotation-loop >/dev/null 2>&1 &
    printf '%s\n' "$!" > "$ROTATION_PID_FILE"
  fi
}

tablet_mode() {
  printf 'tablet\n' > "$MODE_FILE"
  set_touch true
  set_hypr_devices false
  osk_show
  start_rotation
  signal_waybar
  notify "Tablet mode" "Touch and on-screen keyboard enabled"
}

laptop_mode() {
  printf 'laptop\n' > "$MODE_FILE"
  stop_rotation
  apply_transform 0
  osk_hide
  set_hypr_devices true
  set_touch false
  signal_waybar
  notify "Laptop mode" "Touch disabled and rotation reset"
}

toggle_rotation() {
  if [ -e "$ROTATION_LOCK_FILE" ]; then
    rm -f "$ROTATION_LOCK_FILE"
    if [ "$(cat "$MODE_FILE" 2>/dev/null || true)" = "tablet" ]; then
      start_rotation
    fi
    notify "Rotation unlocked"
  else
    touch "$ROTATION_LOCK_FILE"
    stop_rotation
    apply_transform 0
    notify "Rotation locked"
  fi
  signal_waybar
}

tablet_status() {
  local mode="laptop"
  [ -f "$MODE_FILE" ] && mode="$(cat "$MODE_FILE")"
  local rotation="auto"
  [ -e "$ROTATION_LOCK_FILE" ] && rotation="locked"

  if [ "$mode" = "tablet" ]; then
    printf '{"text":"󰦧","class":["tablet","rotation-%s"],"tooltip":"Tablet mode (%s rotation)"}\n' "$rotation" "$rotation"
  else
    printf '{"text":"󰌢","class":["laptop","rotation-%s"],"tooltip":"Laptop mode (%s rotation)"}\n' "$rotation" "$rotation"
  fi
}

rotation_status() {
  if [ -e "$ROTATION_LOCK_FILE" ]; then
    printf '{"text":"󰑷","class":"locked","tooltip":"Rotation locked"}\n'
  else
    printf '{"text":"󰑹","class":"auto","tooltip":"Rotation automatic"}\n'
  fi
}

case "${1:-status}" in
  tablet) tablet_mode ;;
  laptop) laptop_mode ;;
  status) tablet_status ;;
  rotation-status) rotation_status ;;
  toggle-rotation) toggle_rotation ;;
  toggle-osk) "$HOME/.local/bin/osk-toggle" ;;
  rotation-loop) rotation_loop ;;
  reset-transform) apply_transform 0 ;;
  *)
    printf 'Usage: %s [tablet|laptop|status|rotation-status|toggle-rotation|toggle-osk|reset-transform]\n' "$0" >&2
    exit 2
    ;;
esac
